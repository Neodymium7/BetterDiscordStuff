{
	"compilerOptions": {
		"target": "esnext",
		"noImplicitAny": true,
		"strict": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"types": ["node", "bundlebd"],
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"noEmit": true,
		"paths": {
			"@lib": ["./common/lib"],
			"@lib/*": ["./common/lib/*"],
			"@discord": ["./common/discord"],
			"@discord/*": ["./common/discord/*"]
		},
		"skipLibCheck": true
	},
	"exclude": ["./ActivityIcons"]
}
